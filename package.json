{
  "name": "turbospace",
  "version": "1.1.0",
  "description": "TurboSpace — limpeza de TEMP, Prefetch, Docker, Gradle/Android, npm/pip e Desktop. Autoria Dizodias Digital Engineering (https://dizodias.com)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "server": "node index.mjs",
    "dist": "electron-builder --win portable",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac"
  },
  "license": "MIT",
  "author": "Dizodias Digital Engineering <https://dizodias.com>",
  "build": {
    "appId": "com.dizodias.turbospace",
    "productName": "TurboSpace",
    "copyright": "Copyright © Dizodias Digital Engineering — https://dizodias.com",
    "asar": false,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "cleaners/**/*",
      "public/**/*",
      "index.mjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "TurboSpace-Portatil.exe",
      "requestExecutionLevel": "admin",
      "unicode": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "TurboSpace-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "TurboSpace ${version}",
      "window": {
        "width": 540,
        "height": 420
      },
      "contents": [
        {
          "x": 130,
          "y": 150,
          "type": "file"
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 320,
          "type": "file",
          "path": "build/mac/Abrir TurboSpace.command",
          "name": "Abrir TurboSpace.command"
        },
        {
          "x": 410,
          "y": 320,
          "type": "file",
          "path": "build/mac/LEIA-ME - Como abrir.txt",
          "name": "LEIA-ME - Como abrir.txt"
        }
      ]
    },
    "afterSign": "scripts/notarize.cjs"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
